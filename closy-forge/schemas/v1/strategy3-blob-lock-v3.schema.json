{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closy.dev/schemas/v1/strategy3-blob-lock-v3.schema.json",
  "title": "Strategy 3 repository-blob authority lock v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lockVersion",
    "repository",
    "scientificSourceCommit",
    "scientificSourceTree",
    "authorityWrapperSourceCommit",
    "authorityWrapperSourceTree",
    "strategyId",
    "blobs",
    "inventoryDigest",
    "protocol",
    "outcomeVocabulary",
    "lockDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "lockVersion": { "const": "closy.strategy3.repository_blob_authority_lock.v3" },
    "repository": { "type": "string" },
    "scientificSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "scientificSourceTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorityWrapperSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorityWrapperSourceTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "strategyId": { "type": "string" },
    "strategyClass": { "type": "string" },
    "strategyAlgorithmChanged": { "const": false },
    "topologyStrategyBudgetRestored": { "const": false },
    "newStrategyIntroduced": { "const": false },
    "frozenScientificImplementationDigestV2": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "v2MigrationAuditDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "v2MigrationClassification": { "type": "object" },
    "publicConformance": { "type": "object" },
    "baseImageDigest": { "type": "string" },
    "pinnedActions": { "type": "array", "items": { "type": "object" } },
    "blobCount": { "type": "integer", "minimum": 1 },
    "executionImageBlobCount": { "type": "integer", "minimum": 1 },
    "blobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "repository",
          "commit",
          "rootTreeObjectId",
          "repositoryPath",
          "materializedPath",
          "gitMode",
          "objectType",
          "rawBlobOid",
          "rawBlobSha256",
          "rawBlobByteLength",
          "declaredRole",
          "entersExecutionImage"
        ]
      }
    },
    "inventoryDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "protocol": { "type": "object" },
    "isolation": { "type": "object" },
    "budgets": { "type": "object" },
    "authority": { "type": "object" },
    "outcomeVocabulary": { "type": "array", "minItems": 4, "maxItems": 4 },
    "lockCommitChangedPathAllowlist": { "type": "array" },
    "officialSeedCreated": { "const": false },
    "officialFixturePresent": { "const": false },
    "officialResultPresent": { "const": false },
    "lockDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
